# ── Required ──────────────────────────────────────────────────────
# Session signing key. Use 32+ random characters:  openssl rand -hex 32
# Changing it signs everyone out.
JWT_SECRET="replace-with-64-hex-chars"

# Firebase Admin (server). Base64 of the service-account JSON is easiest:
#   base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_B64=""
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ── ECPay 綠界金流 ─────────────────────────────────────────────────
# Local dev (not on Vercel) uses ECPay's public test merchant when empty.
# On Vercel, online payment stays OFF until real credentials are set.
ECPAY_MERCHANT_ID=""
ECPAY_HASH_KEY=""
ECPAY_HASH_IV=""
# "stage" or "production". Default: production on Vercel, stage locally.
ECPAY_MODE=""
# Stage keys are PUBLIC. On Vercel, stage only works with this set to 1, meaning
# the deployment uses a SEPARATE Firebase project (never production data).
ECPAY_STAGE_ISOLATED_DB=""
# Public origin ECPay calls back to (recommended in production):
APP_BASE_URL="https://your-domain.example"

# ── Optional ──────────────────────────────────────────────────────
# Menu image uploads go to this bucket (defaults to NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET).
FIREBASE_STORAGE_BUCKET=""
# Web Push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Gmail notifications
GMAIL_USER=""
GMAIL_APP_PWD=""
